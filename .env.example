# Copy to .env and generate unique secrets before starting. Never commit .env.
WIR_DATABASE_URL=sqlite:///./data/wir.sqlite3
WIR_UPLOAD_DIR=./data/uploads/workers
WIR_LOGO_PATH=./assets/abb-logo.svg
WIR_SESSION_SECRET=replace-with-at-least-32-random-bytes
WIR_CSRF_SECRET=replace-with-a-different-at-least-32-random-bytes
WIR_WORKER_ID_SECRET=replace-with-a-different-at-least-32-random-bytes
WIR_AADHAAR_ENCRYPTION_KEY=
WIR_COOKIE_SECURE=false
WIR_ALLOWED_ORIGIN=http://127.0.0.1:8000

